{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types"
  },
  "include": [
    "src/**/*.ts"
  ]
}
