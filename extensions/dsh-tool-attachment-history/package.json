{
  "name": "dsh-tool-attachment-history",
  "version": "1.1.0",
  "description": "Authorized same-session historical image recall for DeepSeek Harness agents",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./collector": {
      "types": "./lib/types/collector.d.ts",
      "default": "./lib/collector.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "tsconfig.json",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "dsh-attachment-history": "1.1.0",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1.grok.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1.grok.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1.grok.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1.grok.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "24.13.3",
    "dsh-attachment-history": "1.1.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
