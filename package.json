{
  "name": "dsh-llm-grok-oauth",
  "description": "Pinned and hardened dynamic live-catalog SuperGrok OAuth provider for DeepSeek Harness",
  "version": "0.9.0-hardened.1",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "grok",
    "xai",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaizin0226/dsh-supergrok.git"
  },
  "bugs": {
    "url": "https://github.com/Kaizin0226/dsh-supergrok/issues"
  },
  "homepage": "https://github.com/Kaizin0226/dsh-supergrok#readme",
  "author": "wangyaominde",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./hardening": "./supergrok-hardening.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "supergrok-hardening.json",
    "npm-shrinkwrap.json",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "licenses/*.txt",
    "UPSTREAM-PROVENANCE.md",
    "components.lock.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/*.md",
    "presets/grok-optimized/persona-prefix.md",
    "presets/grok-optimized/SOURCE-PROVENANCE.md",
    "presets/grok-optimized/reference-lock.json",
    "presets/grok-optimized/upstream-standard.patch.yml"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "displayName": "SuperGrok OAuth (Hardened)",
      "categories": [
        "llm",
        "provider",
        "oauth"
      ]
    },
    "marketplace": {
      "profiles": [
        "web",
        "headless"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": true
    }
  },
  "scripts": {
    "test": "npm run test:provider && npm run test:preset && npm run test:deployment",
    "test:provider": "node test/run-tests.mjs",
    "test:smoke": "node test/run-tests.mjs smoke",
    "test:preset": "node scripts/derive-grok-preset.mjs --check && node presets/grok-optimized/test-preset.mjs",
    "test:deployment": "node scripts/check-native-package.mjs",
    "safety": "node scripts/check-repository-safety.mjs",
    "history-safety": "node scripts/check-git-history.mjs",
    "canonical-hash": "node scripts/canonical-tree-hash.mjs",
    "source-hash": "node scripts/source-tree-hash.mjs",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run safety && npm run history-safety && npm test && npm run test:docs && npm run pack:check",
    "build:suite": "node scripts/build-suite.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "license": "(MIT AND Apache-2.0)",
  "dependencies": {
    "undici": "7.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "playwright": "1.63.0"
  }
}
