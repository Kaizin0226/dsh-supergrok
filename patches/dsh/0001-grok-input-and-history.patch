@@ -0,0 +1,37 @@
+/** Synthetic preparation adapter; the snapshot replay waterfall owns every response. */
+import type { Context } from '@deepseek-ai/cordis'
+import { LlmAdapter } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, LlmDispatchContext, PreparedAdapterCall, StreamChunk } from '@deepseek-ai/dsh-llm'
+
+export const name = 'prepared-input-snapshot'
+export const inject = ['llm']
+
+class PreparationAdapter extends LlmAdapter {
+  override async prepareCall(
+    provider: string, model: string, signal?: AbortSignal, target?: LlmDispatchContext,
+  ): Promise<PreparedAdapterCall> {
+    const call = await super.prepareCall(provider, model, signal, target)
+    return {
+      ...call,
+      prepareInput: async (options) => {
+        if (target === undefined || target.sessionId !== options.sessionId || target.turn !== options.turn) {
+          throw new Error('snapshot input preparation lost the exact session turn')
+        }
+        return [{
+          key: 'synthetic-image:variant-1',
+          summary: 'Synthetic image prepared; model receipt unconfirmed',
+          text: 'Synthetic image preparation: 4000x1000 -> 2000x500. Fine detail may be lost. Model receipt is unconfirmed.',
+        }]
+      },
+    }
+  }
+
+  async *stream(_options: GenerateOptions): AsyncIterable<StreamChunk> {
+    throw new Error('prepared-input snapshot must use committed Session replay')
+  }
+}
+
+/** Mount an adapter with no network implementation under the recorded route. */
+export function apply(ctx: Context): void {
+  ctx.llm.registerAdapter(['deepseek-official'], new PreparationAdapter())
+}
