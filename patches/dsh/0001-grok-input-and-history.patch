+            "form": "notice", "summary": "Synthetic image prepared; model receipt unconfirmed",
+        }, notice
+        notifications = [notification.payload["event"] for result in results
+                         for notification in result.notifications
+                         if notification.method == "session.event"]
+        assert len([event for event in notifications if is_notice(event)]) == 1
+        records = read_session_logs(sessions)[session_id]
+        assert len([event for event in records if is_notice(event)]) == 1
+        assert next(i for i, event in enumerate(records) if is_notice(event)) < next(
+            i for i, event in enumerate(records) if event.get("type") == "assistant/message"
+        )
+        requests = [json.loads(line) for line in observations.read_text(encoding="utf-8").splitlines()]
+        assert requests == [
