+def smoke_sdk_prepared_input(executable: Path, update_snapshots: bool) -> None:
+    """Persist an ordinary preparation notice once across two SDK turns."""
+    from deepseek_harness import DeepSeekHarness
+
+    session_id = "prepared-input-smoke"
+    notice_text = (
+        "Synthetic image preparation: 4000x1000 -> 2000x500. "
+        "Fine detail may be lost. Model receipt is unconfirmed."
+    )
+
+    def is_notice(event: dict[str, object]) -> bool:
+        data = event.get("data")
+        source = data.get("source") if isinstance(data, dict) else None
+        return event.get("type") == "user/message" and isinstance(source, dict) and source.get("form") == "notice"
+
+    with tempfile.TemporaryDirectory(prefix="dsh-sdk-prepared-input-") as temporary:
+        root = Path(temporary).resolve()
+        home = root / "home"
+        sessions = home / "sessions"
+        observations = root / "observations.jsonl"
+        patch = write_profile_patch(root, "prepared-input.patch.yml", sessions, [
+            {"id": "llm-deepseek", "disabled": True},
+            {"id": "plugin-package-inventory-deepseek", "disabled": True},
+            {"id": "session-title-llm", "disabled": True},
+            {"id": "skill-filesystem", "config": {"includeDefaultRoots": False}},
+            {"id": "tool-bash", "disabled": True},
+            {"id": "tool-pwsh", "disabled": True},
+            {"insert": [{
+                "id": "prepared-input",
+                "name": (Path(__file__).resolve().parent / "fixtures/python-sdk-prepared-input.mjs").as_uri(),
+                "config": {"observations": str(observations)},
+            }]},
+        ])
+        results = []
+        with DeepSeekHarness(
+            provider="prepared-input", model="prepared-input-model", cwd=str(root),
+            dsh_bin=str(executable), dsh_home=str(home), patches=(str(patch),),
+            env={"DSH_PERMISSION_MODE": "danger-full-access", "DSH_TELEMETRY_DISABLED": "1"},
+            request_timeout_seconds=60,
+        ) as harness:
+            for prompt in ("Reply with PONG after preparing the synthetic input.", "Reply with PONG again."):
+                results.append(harness.run(prompt, session_id=session_id))
+        assert [result.final_response for result in results] == ["PONG", "PONG"], [
+            safe_turn_end(next((event.get("data", {}) for event in reversed(result.events)
+                                if event.get("type") == "turn/end"), {})) for result in results
+        ]
+        first_notices = [event for event in results[0].events if is_notice(event)]
+        assert len(first_notices) == 1, first_notices
+        assert not [event for event in results[1].events if is_notice(event)]
+        notice = first_notices[0]
+        assert notice.get("surfaceOp") == "append", notice
+        assert notice["data"]["content"] == [{"type": "text", "text": notice_text}], notice
+        assert notice["data"]["source"] == {
