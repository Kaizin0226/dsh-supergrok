+++ b/packages/llm/llm/tests/prepared-input.spec.ts
@@ -0,0 +1,216 @@
+/** Prepared inputs retain route, turn, cancellation, and one-shot dispatch ownership. */
+
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import { AttachmentId } from '@deepseek-ai/dsh-attachment'
+import LlmRuntime, { LlmAdapter, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type {
+  GenerateOptions, InputPreparationNotice, LlmDispatchContext, PreparedAdapterCall, StreamChunk,
+} from '@deepseek-ai/dsh-llm'
+
+const contexts: Context[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+})
+
+const sessionId = 'prepared-session' as Branded<'SessionId'>
+const route = { provider: 'prepared', model: 'image-model' }
+async function collect(stream: AsyncIterable<StreamChunk>): Promise<StreamChunk[]> {
+  const chunks: StreamChunk[] = []
+  for await (const chunk of stream) chunks.push(chunk)
+  return chunks
+}
+const notice: InputPreparationNotice = {
+  key: 'image:one:variant', summary: 'Image prepared; receipt unconfirmed', text: 'Image resized from 2000x1000 to 1000x500.',
+}
+function request(): GenerateOptions {
+  return {
+    ...route, sessionId, turn: 2,
+    messages: [createUserMessage({ content: [{ type: 'text', text: 'inspect' }], source: { kind: 'user' } })],
+  }
+}
+
+class PreparingAdapter extends LlmAdapter {
+  requests: GenerateOptions[] = []
+  dispatchContexts: (LlmDispatchContext | undefined)[] = []
+  prepare: (options: GenerateOptions) => Promise<readonly InputPreparationNotice[]> = async () => [notice]
+
+  override prepareCall(
+    provider: string, model: string, _signal?: AbortSignal, dispatchContext?: LlmDispatchContext,
+  ): Promise<PreparedAdapterCall> {
+    this.dispatchContexts.push(dispatchContext)
+    return Promise.resolve({
+      model: { provider, id: model, name: model },
+      prepareInput: options => this.prepare(options),
+      stream: options => this.stream(options),
+    })
+  }
+
+  async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+async function harness(adapter = new PreparingAdapter()) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(LlmRuntime)
+  const unregister = ctx.llm.registerAdapter([route.provider], adapter)
+  return { ctx, adapter, unregister }
+}
+
+describe('prepared input dispatch', () => {
+  it('captures a detached session turn and exposes detached notices before one dispatch', async () => {
+    const { ctx, adapter } = await harness()
+    const target = { sessionId, turn: 2 }
+    const prepared = await ctx.llm.prepareCall(route, undefined, target)
+    target.turn = 99
+    expect(adapter.dispatchContexts).toEqual([{ sessionId, turn: 2 }])
+    expect(Object.isFrozen(adapter.dispatchContexts[0])).toBe(true)
+    expect(() => prepared.stream(request())).toThrow('inputs have not completed')
+    const notices = await prepared.prepareInput!(request())
+    expect(notices).toEqual([notice])
+    expect(notices[0]).not.toBe(notice)
+    expect(Object.isFrozen(notices[0])).toBe(true)
+    expect(adapter.requests).toHaveLength(0)
+    await expect(prepared.prepareInput!(request())).rejects.toThrow('only be prepared once')
+    expect(await collect(prepared.stream(request()))).toEqual([{ type: 'finish', reason: { kind: 'stop' } }])
+    expect(() => prepared.stream(request())).toThrow('only be dispatched once')
+    expect(adapter.requests).toHaveLength(1)
+  })
+
+  it.each(['provider', 'model', 'sessionId', 'turn'] as const)(
+    'rejects a changed %s before preparation and after preparation', async (field) => {
+      const { ctx, adapter } = await harness()
+      const changed = { ...request(), [field]: field === 'turn' ? 3 : 'other' }
+      const prepared = await ctx.llm.prepareCall(route, undefined, { sessionId, turn: 2 })
+      await expect(prepared.prepareInput!(changed)).rejects.toMatchObject({ code: 'INVALID_PREPARED_CALL' })
+      await prepared.prepareInput!(request())
+      expect(() => prepared.stream(changed)).toThrow(/changed before adapter dispatch/)
+      expect(adapter.requests).toHaveLength(0)
+    },
+  )
+
+  it('blocks concurrent dispatch and permanently blocks a failed preparation', async () => {
+    const { ctx, adapter } = await harness()
+    const pending = Promise.withResolvers<readonly InputPreparationNotice[]>()
+    adapter.prepare = () => pending.promise
+    const prepared = await ctx.llm.prepareCall(route)
+    const preparing = prepared.prepareInput!(request())
+    const rejected = expect(preparing).rejects.toThrow('unreadable image')
+    expect(() => prepared.stream(request())).toThrow('inputs have not completed')
+    await expect(prepared.prepareInput!(request())).rejects.toThrow('only be prepared once')
+    pending.reject(new Error('unreadable image'))
+    await rejected
+    expect(() => prepared.stream(request())).toThrow('inputs have not completed')
+    expect(adapter.requests).toHaveLength(0)
+  })
+
+  it('rechecks a mutable target after preparation and at lazy terminal dispatch', async () => {
+    const { ctx, adapter } = await harness()
+    const pending = Promise.withResolvers<readonly InputPreparationNotice[]>()
+    adapter.prepare = () => pending.promise
+    const first = await ctx.llm.prepareCall(route, undefined, { sessionId, turn: 2 })
+    const changing = request()
+    const preparing = first.prepareInput!(changing)
+    changing.turn = 3
+    pending.resolve([])
+    await expect(preparing).rejects.toMatchObject({ code: 'INVALID_PREPARED_CALL' })
+    adapter.prepare = async () => []
+    const second = await ctx.llm.prepareCall(route, undefined, { sessionId, turn: 2 })
+    const delayed = request()
+    await second.prepareInput!(delayed)
+    const stream = second.stream(delayed)
+    delayed.turn = 3
+    expect(await collect(stream)).toMatchObject([{
+      type: 'finish', reason: { kind: 'error', failure: { code: 'INVALID_PREPARED_CALL' } },
+    }])
+    expect(adapter.requests).toHaveLength(0)
+  })
+
+  it('permits notice-free direct calls and rejects direct transformations requiring a logged explanation', async () => {
+    const { ctx, adapter } = await harness()
+    expect(await collect(ctx.llm.stream(request()))).toMatchObject([{
+      type: 'finish', reason: { kind: 'error', failure: { code: 'INVALID_PREPARED_CALL' } },
+    }])
+    expect(adapter.requests).toHaveLength(0)
+    adapter.prepare = async () => []
+    expect(await collect(ctx.llm.stream({ ...request(), purpose: 'compaction' }))).toEqual([
+      { type: 'finish', reason: { kind: 'stop' } },
+    ])
+    expect(adapter.requests).toHaveLength(1)
+  })
+
+  it('keeps text and native image references unchanged in notice-free compaction', async () => {
+    const { ctx, adapter } = await harness()
+    let preparedOptions: GenerateOptions | undefined
+    adapter.prepare = async (options) => {
+      preparedOptions = options
+      return []
+    }
+    const options: GenerateOptions = {
+      ...request(), purpose: 'compaction',
+      messages: [createUserMessage({
+        content: [
+          { type: 'text', text: 'retain this text exactly' },
+          { type: 'image', attachment: {
+            attachmentId: AttachmentId('fixture-image'), mediaType: 'image/png', bytes: 16, width: 2, height: 2,
+          } },
+        ],
+        source: { kind: 'user' },
+      })],
+    }
+    expect(await collect(ctx.llm.stream(options))).toEqual([{ type: 'finish', reason: { kind: 'stop' } }])
+    expect(preparedOptions?.messages).toEqual(options.messages)
+    expect(adapter.requests[0]?.messages).toEqual(options.messages)
+  })
+
+  it.each(['failure', 'abort'] as const)('never dispatches a direct call after preparation %s', async (reason) => {
+    const { ctx, adapter } = await harness()
+    const abort = new AbortController()
+    adapter.prepare = async () => {
+      if (reason === 'failure') throw new Error('unreadable input')
+      abort.abort()
+      return []
+    }
+    const chunks = await collect(ctx.llm.stream({ ...request(), signal: abort.signal }))
+    expect(chunks).toMatchObject([{ type: 'finish', reason: { kind: reason === 'abort' ? 'aborted' : 'error' } }])
+    expect(adapter.requests).toHaveLength(0)
+  })
+
+  it.each(['lookup', 'input'] as const)('honors the %s cancellation while preparation is pending', async (owner) => {
+    const { ctx, adapter } = await harness()
+    const pending = Promise.withResolvers<readonly InputPreparationNotice[]>()
+    adapter.prepare = () => pending.promise
+    const abort = new AbortController()
+    const options = { ...request(), ...owner === 'input' ? { signal: abort.signal } : {} }
+    const prepared = await ctx.llm.prepareCall(route, owner === 'lookup' ? abort.signal : undefined)
+    const preparing = prepared.prepareInput!(options)
+    const rejected = expect(preparing).rejects.toThrow('cancelled preparation')
+    abort.abort(new Error('cancelled preparation'))
+    pending.resolve([notice])
+    await rejected
+    expect(() => prepared.stream(request())).toThrow('inputs have not completed')
+    expect(adapter.requests).toHaveLength(0)
+  })
+
+  it('rejects cancellation after successful preparation and keeps the captured adapter after HMR', async () => {
+    const { ctx, adapter, unregister } = await harness()
+    const cancelled = await ctx.llm.prepareCall(route)
+    const abort = new AbortController()
+    const options = { ...request(), signal: abort.signal }
+    await cancelled.prepareInput!(options)
+    abort.abort(new Error('cancelled dispatch'))
+    expect(() => cancelled.stream(options)).toThrow('cancelled dispatch')
+    const prepared = await ctx.llm.prepareCall(route)
+    await prepared.prepareInput!(request())
+    const replacement = new PreparingAdapter()
+    unregister()
+    ctx.effect(() => ctx.llm.registerAdapter([route.provider], replacement))
+    await collect(prepared.stream(request()))
+    expect(adapter.requests).toHaveLength(1)
+    expect(replacement.requests).toHaveLength(0)
+  })
+})
