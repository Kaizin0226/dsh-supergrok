+            for stage, turn, count in (("prepare", 1, 0), ("stream", 1, 1), ("prepare", 2, 1), ("stream", 2, 1))
+        ], requests
+        replacements = [(json.dumps(str(root), ensure_ascii=False)[1:-1], "{{cwd}}"),
+                        (str(root), "{{cwd}}"), (session_id, "{{parent}}")]
+        values = [{
+            "session_id": result.session_id, "final_response": result.final_response,
+            "events": result.events,
+            "notifications": [{"method": n.method, "payload": n.payload} for n in result.notifications],
+        } for result in results]
+        content = render_jsonl(project_session_snapshot([
+            normalize_snapshot_value(record, replacements) for record in records
+        ]))
+        files = {
