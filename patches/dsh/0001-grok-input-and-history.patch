@@ -0,0 +1,146 @@
+/** Prepared input notices remain ordinary replayable messages under system-prompt admission. */
+
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { createUserMessage, isAgentLoopRequest, LlmError } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, InputPreparationNotice, LlmDispatchContext, PreparedAdapterCall } from '@deepseek-ai/dsh-llm'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse, toolCallResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+})
+
+const notice: InputPreparationNotice = {
+  key: 'image:fixture:variant', summary: 'Image resized for sending; receipt unconfirmed',
+  text: 'Image fixture prepared: 4000x1000 -> 2000x500. Fine detail may be lost.',
+}
+class PreparingAdapter extends MockAdapter {
+  inputs: GenerateOptions[] = []
+  targets: (LlmDispatchContext | undefined)[] = []
+  prepare: (options: GenerateOptions) => Promise<readonly InputPreparationNotice[]> = async () => [notice]
+
+  override async prepareCall(
+    provider: string, model: string, signal?: AbortSignal, target?: LlmDispatchContext,
+  ): Promise<PreparedAdapterCall> {
+    this.targets.push(target)
+    return {
+      ...await super.prepareCall(provider, model, signal, target),
+      prepareInput: (options) => {
+        this.inputs.push(options)
+        return this.prepare(options)
+      },
+    }
+  }
+}
+
+async function harness(adapter: PreparingAdapter) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.effect(() => ctx.llm.registerAdapter(['mock'], adapter))
+  ctx.systemPrompt.section({ name: 'test-persona', order: 10, text: 'Stable system prompt' })
+  const agent = await ctx.agentLoop.create(SessionId('prepared-input'), { provider: 'mock', model: 'mock' })
+  return { ctx, agent }
+}
+
+async function send(agent: Agent, text: string) {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+  await agent.whenIdle()
+}
+
+function notices(session: Session) {
+  return session.snapshotEvents().filter(event => event.type === 'user/message'
+    && event.data.source.kind === 'plugin' && event.data.source.plugin.startsWith('llm-input-preparation:'))
+}
+
+describe('loop input preparation', () => {
+  it('logs once while visible, re-emits after replacement, and reconstructs frozen requests including system history', async () => {
+    const adapter = new PreparingAdapter([textResponse('first'), textResponse('second'), textResponse('after compact')])
+    const { ctx, agent } = await harness(adapter)
+    ctx.on('llm/stream', (request, next) => {
+      expect(isAgentLoopRequest(request)).toBe(true)
+      expect(request.messages).toEqual(agent.session.deriveMessages())
+      expect(Object.isFrozen(request)).toBe(true)
+      expect(Object.isFrozen(request.messages)).toBe(true)
+      expect(request.messages.every(message => Object.isFrozen(message.content))).toBe(true)
+      return next()
+    })
+    await send(agent, 'first')
+    await send(agent, 'second')
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'turn/end').map(event => event.data.reason)).toEqual([
+      { kind: 'completed' }, { kind: 'completed' },
+    ])
+    expect(notices(agent.session)).toHaveLength(1)
+    expect(notices(agent.session)[0]?.data).toMatchObject({ source: {
+      kind: 'plugin', form: 'notice', summary: notice.summary,
+    } })
+    expect(adapter.inputs[0]?.messages.some(message => message.role === 'system')).toBe(true)
+    expect(adapter.inputs[0]?.messages.some(message => message.content.some(block => block.type === 'text' && block.text === notice.text))).toBe(false)
+    expect(adapter.requests[0]?.messages.at(-1)?.content).toEqual([{ type: 'text', text: notice.text }])
+    expect(adapter.requests.every(request => request.system === undefined)).toBe(true)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'request/header')).toHaveLength(1)
+    const nodes = [...agent.session.surface.nodes].slice(1)
+    agent.session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'Summary retaining the image reference' }],
+      source: { kind: 'plugin', plugin: 'fixture-compaction' },
+    }), { surfaceOp: { op: 'replace', startSeq: nodes[0]!, endSeq: nodes.at(-1)! }, sourceEventSeqs: nodes })
+    await send(agent, 'after compact')
+    expect(notices(agent.session)).toHaveLength(2)
+    const replay = Session.create(SessionId('prepared-input-replay'), structuredClone(agent.session.snapshotEvents()))
+    expect(replay.deriveMessages()).toEqual(agent.session.deriveMessages())
+    expect(adapter.targets).toEqual([1, 2, 3].map(turn => ({ sessionId: agent.id, turn })))
+  })
+
+  it('shares the captured turn across tool continuation without duplicating notices', async () => {
+    const adapter = new PreparingAdapter([toolCallResponse('echo-call', 'echo', {}), textResponse('done')])
+    const { ctx, agent } = await harness(adapter)
+    ctx.tools.register(defineContentToolFixture({
+      name: 'echo', description: 'Return synthetic text', parameters: {},
+      async execute() { return [{ type: 'text', text: 'synthetic tool result' }] },
+    }))
+    await send(agent, 'use echo')
+    expect(agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data.reason).toEqual({ kind: 'completed' })
+    expect(adapter.requests).toHaveLength(2)
+    expect(adapter.targets).toEqual([{ sessionId: agent.id, turn: 1 }, { sessionId: agent.id, turn: 1 }])
+    expect(adapter.requests.map(request => request.turn)).toEqual([1, 1])
+    expect(notices(agent.session)).toHaveLength(1)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'tool/result')).toHaveLength(1)
+  })
+
+  it('ends failed preparation without sending or recording a successful preparation notice', async () => {
+    const adapter = new PreparingAdapter([textResponse('must not run')])
+    adapter.prepare = async () => { throw new LlmError('unreadable image', 'INVALID_REQUEST') }
+    const { agent } = await harness(adapter)
+    await send(agent, 'inspect')
+    expect(adapter.requests).toHaveLength(0)
+    expect(notices(agent.session)).toHaveLength(0)
+    expect(agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data).toMatchObject({
+      reason: { kind: 'error', error: { code: 'INVALID_REQUEST' } },
+    })
+  })
+
+  it('discards late notices when cancellation wins a pending input preparation', async () => {
+    const adapter = new PreparingAdapter([textResponse('must not run')])
+    const started = Promise.withResolvers<undefined>()
+    const pending = Promise.withResolvers<readonly InputPreparationNotice[]>()
+    adapter.prepare = () => { started.resolve(undefined); return pending.promise }
+    const { agent } = await harness(adapter)
+    const sending = send(agent, 'inspect')
+    await started.promise
+    agent.cancel({ kind: 'disposed' })
+    pending.resolve([notice])
+    await sending
+    expect(adapter.requests).toHaveLength(0)
+    expect(notices(agent.session)).toHaveLength(0)
+    expect(agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data).toMatchObject({
+      reason: { kind: 'aborted' },
+    })
+  })
+})
