+import { appendFileSync } from 'node:fs'
+
+export const name = 'python-sdk-prepared-input'
+export const inject = ['llm']
+
+const notice = {
+  key: 'synthetic-image:variant-1',
+  summary: 'Synthetic image prepared; model receipt unconfirmed',
+  text: 'Synthetic image preparation: 4000x1000 -> 2000x500. Fine detail may be lost. Model receipt is unconfirmed.',
+}
+
+/** A keyless adapter that exercises preparation through the shipped SDK composition. */
+export function apply(ctx, config) {
+  const resolveModel = async (provider, model) => ({
+    provider, id: model, name: model, inputModalities: ['text', 'image'],
+  })
+  const record = (stage, options, target) => {
+    if (target === undefined || target.sessionId !== options.sessionId || target.turn !== options.turn) {
+      throw new Error('SDK input preparation lost the exact session turn')
+    }
+    options.signal?.throwIfAborted()
+    const noticeCount = options.messages.filter(message => message.role === 'user'
+      && message.content.some(block => block.type === 'text' && block.text === notice.text)).length
+    appendFileSync(config.observations, JSON.stringify({
+      stage, sessionId: options.sessionId, turn: options.turn, noticeCount,
+    }) + '\n')
+    return noticeCount
+  }
+  ctx.effect(() => ctx.llm.registerAdapter(['prepared-input'], {
+    providerInfo: provider => ({ id: provider, name: provider }),
+    providerRetryPolicy: () => undefined,
+    imageRequestPricing: () => undefined,
+    listModels: async provider => [await resolveModel(provider, 'prepared-input-model')],
+    resolveModel,
+    async prepareCall(provider, model, _signal, target) {
+      return {
+        model: await resolveModel(provider, model),
+        async prepareInput(options) {
+          record('prepare', options, target)
+          return [notice]
+        },
+        async *stream(options) {
+          if (record('stream', options, target) !== 1) {
+            throw new Error('SDK dispatch must contain exactly one durable preparation notice')
+          }
+          yield { type: 'block-start', index: 0, blockType: 'text' }
+          yield { type: 'text-delta', index: 0, text: 'PONG' }
+          yield { type: 'block-end', index: 0, block: { type: 'text', text: 'PONG' } }
+          yield { type: 'finish', reason: { kind: 'stop' } }
+        },
+      }
+    },
+    stream() {
+      throw new Error('SDK preparation requires an explicit prepared call')
+    },
+  }))
+}
